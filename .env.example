# Settings for docker-compose.yml (Remote Web Control for Cura).
#
# Copy it to ".env" (in the same folder as docker-compose.yml) and fill in what you need.
# Every variable is optional: a line left empty uses the default given in its comment.
#
#   cp .env.example .env

# ---------------------------------------------------------------- Cura

# UltiMaker Cura version installed in the image (one published at
# https://github.com/Ultimaker/Cura/releases). Default: 5.13.0
# Remote Web Control is tested with 5.13.0 and needs 5.13 or later.
CURA_VERSION=

# Series of that version: its first two numbers (5.13.0 -> 5.13). It is the name of Cura's
# configuration folder. Default: 5.13
CURA_SERIES=

# Folder with your Cura configuration, exported with scripts/export_cura_config.sh.
# It must contain "config/" and "data/". The jobs and the token are stored here too.
# Default: ./cura-data
CURA_DATA_DIR=

# Less memory (~100 MB): printer brands whose resources are kept, separated by spaces.
# They are the prefixes of Cura's definitions: for example "creality", "prusa", "anycubic",
# "ultimaker" or "custom" (custom printers). The common base, the generic materials and
# everything your printers use are always kept; if any printer would break, nothing is
# removed and the logs say so.
# Empty = keep everything (needed to add a printer of another brand through noVNC).
# Example: CURA_KEEP_VENDORS=creality custom
CURA_KEEP_VENDORS=

# ---------------------------------------------------------------- Network

# Server port for the API and the phone app. Default: 8765
RWC_PORT=

# Address phones use to reach the app, for example http://192.168.1.10:8765/
# Only needed if you open the pairing page on the server itself through "localhost"; from
# any other computer, the address you opened the page with is used.
RWC_PUBLIC_URL=

# ---------------------------------------------------------------- noVNC (Cura's screen)

# Password to see Cura's screen in a browser (http://<server>:6080/vnc.html).
# Empty = noVNC off. The connection is not encrypted: only use it on your local network.
# VNC only uses the first 8 characters of the password.
VNC_PASSWORD=

# Server port for noVNC. Default: 6080
NOVNC_PORT=
